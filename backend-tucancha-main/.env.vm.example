# Copiar a .env en la VM: cp .env.vm.example .env
# API: https://api.tucancha.com.pe | Web: https://tucancha.com.pe

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

SERVICES_URL=https://api.tucancha.com.pe
WEB_SERVICES_URL=https://tucancha.com.pe
CORS_ORIGINS=https://tucancha.com.pe,https://www.tucancha.com.pe

JWT_SECRET=
JWT_REFRESH_SECRET=
# auth.service usa JWT_ACCESS_SECRET; si solo tienes JWT_SECRET, el entrypoint lo copia
JWT_ACCESS_SECRET=
GOOGLE_CLIENT_ID=

AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MP_ACCESS_TOKEN=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=
MP_CLIENT_ID=

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DATABASE=
DATABASE_SSL=true
DATABASE_SYNCHRONIZE=false

RESEND_API_KEY=
SENTRY_DSN=
